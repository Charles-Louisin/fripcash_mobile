{
  "expo": {
    "name": "FripCash",
    "slug": "fripcash-mobile",
    "owner": "charles-louisins-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fripcash",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF5F1",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "FripCash utilise l'appareil photo pour photographier tes articles et tes justificatifs.",
        "NSPhotoLibraryUsageDescription": "FripCash accède à tes photos pour illustrer tes annonces et ton profil.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C0603C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "ef74af0d-6523-475b-babd-fda1a3d988ea"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C0603C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FripCash accède à tes photos pour illustrer tes annonces et ton profil.",
          "cameraPermission": "FripCash utilise l'appareil photo pour photographier tes articles et tes justificatifs."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C0603C"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FripCash utilise Face ID pour déverrouiller ton compte."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/ef74af0d-6523-475b-babd-fda1a3d988ea"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
