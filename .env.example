# URL de l'API FripCash (avec /api/v1).
# Ce n'est PAS l'URL du tunnel Expo. Le tunnel sert uniquement le JS de l'app.
#
# Même Wi-Fi : http://<IP-LAN-du-PC>:5000/api/v1
# Backend public : https://api.ton-domaine.com/api/v1
#
# Copie ce fichier vers .env puis : npx expo start --tunnel --clear

EXPO_PUBLIC_API_URL=http://10.0.0.1:5000/api/v1
